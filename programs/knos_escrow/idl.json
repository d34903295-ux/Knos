 "metadata": {
  "name": "knos_escrow",
  "version": "0.3.7",
  "spec": "0.1.0",
  "description": "Knos escrow: pay-on-acceptance or pay-on-proof escrow for AI agent jobs (SPL tokens)",
  "repository": "https://github.com/drexthealpha/Knos"
 },
 "docs": [
  "A native program, not Anchor: each instruction's discriminator is its one-byte tag, accounts carry no discriminator and are told apart by size (Job 225 bytes, 257 for a job in a registered mint (the job + mint), 217 for 0.3.4 jobs, 153 before; Config2 124). Layouts are packed little-endian. Every settlement closes the job and returns its rent to the buyer."
 ],
