{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.drexthealpha/knos",
  "title": "Knos",
  "description": "Shared Sibyl memory and file claims for every coding agent on this machine; start with: knos mcp",
  "version": "0.2.1",
  "repository": {
    "url": "https://github.com/drexthealpha/Knos",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "knos",
      "version": "0.2.1",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
